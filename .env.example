# Lokale Entwicklung mit scripts/devdb.sh (Port 5433) – für Docker Compose Port 5432 verwenden
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/finanzplaner
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/finanzplaner_test
CORS_ORIGINS=["http://localhost:5173"]

# Lokale KI für die Prüfliste (leer = aus). Ollama: http://<rechner>:11434 – LM Studio u. a.: http://<rechner>:1234/v1
AI_URL=
AI_MODEL=gemma4:e2b
# Bildmodell für Belege/Scans (leer = AI_MODEL); muss Bilder verstehen, z. B. ein Vision-Modell in Ollama
AI_VISION_MODEL=
# Zweiter KI-Server (Priorität 2) – übernimmt, wenn der erste nicht erreichbar ist
AI_URL_2=
# Modell auf dem zweiten Server (leer = AI_MODEL) und dessen Bildmodell (leer = AI_MODEL_2)
AI_MODEL_2=
AI_VISION_MODEL_2=
# So lange wird ein ausgefallener Server übersprungen (Sekunden)
AI_FAILOVER_COOLDOWN_SECONDS=60
# Kurzer Verbindungstest vor jeder Anfrage (Sekunden)
AI_CONNECT_TIMEOUT_SECONDS=5
# Hochgeladene Belege und Verträge
DOCUMENT_DIR=documents
